{
  "name": "herdsman",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src test",
    "validate": "npm run check && npm run lint && npm run format:check && npm test",
    "test": "tsx --test test/*.test.ts",
    "wake": "tsx src/wake.ts",
    "cc": "tsx src/cc.ts",
    "coordinator": "tsx src/coordinator.ts",
    "review": "tsx src/review.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@types/node": "^24.0.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  }
}
